{
  "fps": 30,
  "width": 1080,
  "height": 1920,
  "beats": [
    {
      "name": "a_open",
      "source": "footage/clip_a.mp4",
      "in": 0.5,
      "out": 3.0,
      "role": "hook",
      "grade": "none",
      "vf": "scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,setsar=1"
    },
    {
      "name": "b_mid",
      "source": "footage/clip_b.mp4",
      "in": 0.0,
      "out": 2.0,
      "role": "broll",
      "grade": "none",
      "vf": "scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,setsar=1"
    },
    {
      "name": "c_end",
      "source": "footage/clip_c.mp4",
      "in": 0.5,
      "out": 2.5,
      "role": "broll",
      "grade": "none",
      "vf": "scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,setsar=1"
    }
  ],
  "audio": {
    "from_beats": false,
    "bed": {
      "source": "audio/music.mp3",
      "gain": 1.0
    }
  },
  "output": "final_raw.mp4"
}
